{
  "name": "game-quiz",
  "version": "1.0.0",
  "description": "WOHI 2 project",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "db:migrate": "npx prisma migrate dev",
    "db:seed": "npx prisma db seed",
    "db:studio": "npx prisma studio",
    "db:reset": "npx prisma migrate reset",
    "test": "cross-env NODE_ENV=test LOG_LEVEL=silent vitest run",
    "test:watch": "cross-env NODE_ENV=test LOG_LEVEL=silent vitest",
    "test:coverage": "cross-env NODE_ENV=test LOG_LEVEL=silent vitest run --coverage",
    "test:setup": "npx prisma migrate deploy"
  },
  "keywords": [
    "express",
    "nodejs",
    "backend",
    "api"
  ],
  "author": "KhoaDo",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.15",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "prisma": "^6.19.3",
    "supertest": "^7.1.4",
    "vitest": "^4.0.15"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
